# Modelo do .env. Copie e preencha:
#   cp .env.example .env
#
# O .env real não é versionado — ele contém credenciais.

# UID/GID do usuário no host, usados pelo container do backend para que
# arquivos gerados (migrations, etc.) não fiquem com dono root.
# Descubra os seus com: id -u && id -g
UID=1000
GID=1000

# Chave que assina os JWTs. Trocá-la desloga todo mundo. Gere a sua com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Credenciais do Postgres (apenas desenvolvimento local)
POSTGRES_DB=hospeda
POSTGRES_USER=hospeda
POSTGRES_PASSWORD=troque-me

# Login do pgAdmin em http://localhost:5050
PGADMIN_EMAIL=admin@hospeda.dev
PGADMIN_PASSWORD=troque-me
