# UID/GID do usuário no host, usados pelo container do backend para que
# arquivos gerados (migrations, etc.) não fiquem com dono root.
# Descubra os seus com: id -u && id -g
UID=1001
GID=1001

# Credenciais do Postgres (apenas desenvolvimento local)
POSTGRES_DB=hospeda
POSTGRES_USER=hospeda
POSTGRES_PASSWORD=hospeda

# Login do pgAdmin em http://localhost:5050
PGADMIN_EMAIL=admin@hospeda.dev
PGADMIN_PASSWORD=admin
